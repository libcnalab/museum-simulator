# Build trees (shared names only: build/, build-asan/, build-probe/, ...)
/build*/
*.o
*.a
__pycache__/
.cache/
compile_commands.json

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Screenshots and scratch output
/shots/
*.log

# Android: Gradle project state and local SDK path
/android/.gradle/
/android/local.properties

# Execution evidence: the run logs are hashed in audit/execution_evidence.json and must be tracked
!audit/runs/*.log
